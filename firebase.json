{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "videos/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/view",
        "destination": "/view.html"
      },
      {
        "source": "/v4m8s",
        "destination": "/photobooth.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
